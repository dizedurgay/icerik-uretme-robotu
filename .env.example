# --- Zorunlu: Gemini API anahtarı (ücretsiz) ---
# aistudio.google.com → "Get API key" → anahtar oluştur
GEMINI_API_KEY=

# --- Metin modelleri (ücretsiz katman; güncel liste: aistudio.google.com/docs/pricing) ---
TEXT_MODEL=gemini-3.8-flash
# Kontrol katmanı daha hafif modelle çalışır (günlük kotayı korur)
REVIEW_MODEL=gemini-3.5-flash-lite
# Ana model yoğunsa (503) veya günlük kotası dolduysa sırayla denenecek yedek ücretsiz modeller
FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# Kenar çubuğundaki günlük istek sayacının üst sınırı (yalnızca bilgi amaçlı).
# Kendi gerçek limitini AI Studio → Rate limits sayfasından bakıp yaz.
GEMINI_DAILY_REQUEST_LIMIT=250

# --- Seslendirme (edge-tts, anahtar gerektirmez) ---
# tr-TR-EmelNeural (kadın) | tr-TR-AhmetNeural (erkek); arayüzden de seçilebilir
TTS_VOICE=tr-TR-EmelNeural
